{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kimi_quota.sh\" sessionstart",
            "timeoutMs": 3000,
            "statusMessage": "检查会话模型"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kimi_quota.sh\" prompt",
            "timeoutMs": 4000,
            "statusMessage": "查询 Kimi 用量"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kimi_quota.sh\" stop",
            "timeoutMs": 4000,
            "statusMessage": "检查 Kimi 用量状态行"
          }
        ]
      }
    ]
  }
}
